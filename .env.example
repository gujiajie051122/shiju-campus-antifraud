# Optional OpenAI-compatible controlled reply and retrieval-augmented generation.
# Credentials stay on server. No provider or model is chosen by default.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# schema (default), or json for providers with JSON mode only; both validated locally.
LLM_OUTPUT_FORMAT=schema
# Shared dialogue/knowledge/reflection request caps; Shanghai midnight reset. Zero disables calls.
# Competition default: anonymous visitors can use all AI features. Set true only
# when intentionally requiring the hosting platform's authenticated identity.
AI_REQUIRE_SIGN_IN=false
AI_USER_DAILY_LIMIT=200
AI_SITE_DAILY_LIMIT=1000
AI_USER_PER_MINUTE=6
AI_MIN_INTERVAL_MS=1500
AI_SITE_CONCURRENT=3
